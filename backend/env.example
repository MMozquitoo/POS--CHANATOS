# Pedidos web -> POS (Domicilios)
# Copia estas 4 lineas a tu .env real. Si las dejas vacias, el poller no
# arranca y el POS sigue funcionando exactamente igual que antes.

# URL del servicio en Railway que recibe los pedidos de chanatos-web
WEB_ORDERS_ENDPOINT=https://domicilioschanatos-production.up.railway.app
# Mismo valor que WEB_ORDERS_SECRET en Railway y en Vercel (chanatos-web)
WEB_ORDERS_SECRET=
# PIN del usuario "Pedidos Web" que el poller usa para crear ordenes.
# Se crea solo la primera vez que arranca el servidor con este PIN puesto.
WEB_ORDERS_POLLER_PIN=
# Cada cuanto consulta la cola, en milisegundos (opcional, default 20000)
WEB_ORDERS_POLL_INTERVAL_MS=20000

# Publicación programada en Instagram (2026-10-29)
# Si las dejas vacias, la pantalla de Instagram muestra el aviso de "falta
# configurar" y el poller no arranca; el resto del POS sigue igual.

# Token de acceso de la cuenta de Instagram (System User de Meta Business,
# permiso instagram_content_publish). Generado una vez en business.facebook.com
# -> Usuarios del sistema; con expiracion "Nunca" no hace falta renovarlo.
INSTAGRAM_ACCESS_TOKEN=
# ID numerico de la cuenta profesional de Instagram (no el @usuario)
INSTAGRAM_ACCOUNT_ID=
# Cada cuanto revisa si hay algo programado para publicar, en milisegundos (opcional, default 60000)
INSTAGRAM_POLL_INTERVAL_MS=60000

# Vercel Blob: aloja temporalmente las imagenes para que Instagram pueda leerlas
# (su API exige una URL publica, no acepta subir el archivo directo).
# Se crea en vercel.com -> Storage -> Create Database -> Blob -> copiar el token
BLOB_READ_WRITE_TOKEN=
